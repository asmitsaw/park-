FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DEVICE_SHARED_SECRET=replace-with-the-same-device-secret-used-in-esp32
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@parkplus.local
ADMIN_PASSWORD=change-this-before-first-run
ADMIN_NAME=PARK+ Administrator
MIN_PARKING_ALLOWANCE_SECONDS=900
OVERAGE_RATE_PER_HOUR_PAISE=5000
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
SLOT_DISTANCE_THRESHOLD_CM=20.0

# Telegram: set the new token generated by BotFather and your numeric chat ID.
# Existing project env may use the legacy key telegram_bot_token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
